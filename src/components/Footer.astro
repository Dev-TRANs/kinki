style
  .site-footer {
    background-color #111827;
    color #9ca3af;
    padding 4.5rem 0 2rem;
    font-size 0.9rem;
  }

  .footer-top {
    display grid;
    grid-template-columns 1.5fr 1fr;
    gap 3rem;
    padding-bottom 3rem;
    border-bottom 1px solid #1f2937;
  }

  .org-name {
    color #ffffff;
    font-weight 700;
    font-size 1.15rem;
    margin-bottom 0.25rem;
  }

  .org-tagline {
    color #60a5fa;
    font-size 0.85rem;
    font-weight 600;
    margin-bottom 1rem;
  }

  .org-desc {
    font-size 0.85rem;
    line-height 1.7;
    max-width 420px;
  }

  .footer-links {
    display flex;
    gap 3rem;
  }

  .col-title {
    color #ffffff;
    font-weight 600;
    font-size 0.9rem;
    margin-bottom 1rem;
  }

  .footer-col ul {
    list-style none;
    padding 0;
    margin 0;
    display flex;
    flex-direction column;
    gap 0.65rem;
  }

  .footer-col a {
    color #9ca3af;
    transition color 0.2s ease;
  }

  .footer-col ahover {
    color #ffffff;
  }

  .footer-bottom {
    margin-top 2rem;
    text-align center;
    font-size 0.8rem;
    color #6b7280;
  }

   スマホ表示 (768px以下) 
  @media (max-width 768px) {
    .site-footer {
      padding 3rem 0 1.5rem;
    }

    .footer-top {
      grid-template-columns 1fr;
      gap 2rem;
    }

    .footer-links {
      flex-direction column;
      gap 1.5rem;
    }
  }
style