---
---

<header class="site-header">
  <div class="container nav-wrap">
    <a href="/kinki/" class="brand-logo">
      <div class="logo-mark">
        <span class="mark-yellow"></span>
        <span class="mark-blue"></span>
      </div>
      <div class="brand-text">
        <span class="brand-title font-brand">近畿生徒会</span>
        <span class="brand-sub">K-SCEM</span>
      </div>
    </a>

    <nav class="nav-links">
      <a href="/kinki/">ホーム</a>
      <a href="/kinki/about/">理念・特徴</a>
      <a href="/kinki/event/">次回イベント</a>
      <a href="/kinki/records/">開催実績</a>
      <a href="/kinki/contact/" class="nav-cta">お問い合わせ</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 2px solid #E2E8F0;
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .nav-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }
  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }
  .logo-mark {
    width: 32px;
    height: 32px;
    position: relative;
    display: flex;
  }
  .mark-yellow {
    width: 18px;
    height: 28px;
    background-color: #FACC15;
    border-radius: 14px 4px 14px 14px;
    transform: rotate(-10deg);
  }
  .mark-blue {
    width: 18px;
    height: 28px;
    background-color: #1677FF;
    border-radius: 14px 14px 4px 14px;
    margin-left: -6px;
    transform: rotate(10deg);
  }
  .brand-text {
    display: flex;
    flex-direction: column;
  }
  .brand-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: #1E293B;
  }
  .brand-sub {
    font-size: 0.7rem;
    font-weight: 700;
    color: #1677FF;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }
  .nav-links a {
    font-size: 0.95rem;
    font-weight: 600;
    color: #1E293B;
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-links a:hover {
    color: #1677FF;
  }
  .nav-cta {
    background-color: #1677FF !important;
    color: #ffffff !important;
    padding: 0.55rem 1.35rem;
    border-radius: 9999px;
    font-weight: 700 !important;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .nav-cta:hover {
    background-color: #0958d9 !important;
  }
  @media (max-width: 768px) {
    .nav-links { display: none; }
  }
</style>
