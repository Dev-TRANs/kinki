---
interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "近畿圏の中学・高校生徒会役員がつながるコミュニティ「近畿生徒会交流会（K-SCEM）」。学校の垣根を越えて悩みや事例を共有できる場を提供しています。" 
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/kinki/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;800;900&family=Shippori+Mincho:wght@700;800&display=swap" rel="stylesheet">
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* ロゴ・バナーから抽出した強力なビビッドパレット */
    --kscem-blue: #0077FF;        /* 鮮明で力強いシンボルブルー */
    --kscem-blue-hover: #0056cc;
    --kscem-yellow: #FFCC00;      /* パキッとしたビビッドイエロー */
    --kscem-yellow-deep: #D99B00;
    --kscem-dark-blue: #0F2038;   /* 締まりのある重厚なネイビー */
    --kscem-muted-blue: #326B8E;  /* 添付バナー由来の印象深いくすみブルー */
    --kscem-cream: #FFFDF0;       /* 温かみのあるアイボリー背景 */
    
    --text-main: #0F2038;
    --text-sub: #4A5568;
    --border-strong: #CBD5E1;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'Noto Sans JP', sans-serif;
    color: var(--text-main);
    line-height: 1.75;
    background-color: var(--kscem-cream);
  }

  .font-brand {
    font-family: 'Shippori Mincho', serif;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .container {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 800;
    text-align: center;
    margin-bottom: 2.5rem;
    position: relative;
    color: var(--kscem-dark-blue);
  }

  .section-title::after {
    content: '';
    display: block;
    width: 56px;
    height: 5px;
    background-color: var(--kscem-yellow);
    margin: 0.85rem auto 0;
    border-radius: 9999px;
  }
</style>
